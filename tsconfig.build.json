{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/__tests__",
    "src/stories",
    "src/test-support",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}
