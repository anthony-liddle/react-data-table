{
  "name": "@anthony-liddle/react-data-table",
  "version": "0.5.1",
  "description": "A data-dense React table: sorting, grouped columns, row and drag selection, column management, pagination, and URL + localStorage persistence. Precompiled CSS with documented class names, themed by shadcn-style tokens.",
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "sorting",
    "pagination",
    "selection",
    "css",
    "shadcn"
  ],
  "homepage": "https://anthony-liddle.github.io/react-data-table/",
  "bugs": {
    "url": "https://github.com/anthony-liddle/react-data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthony-liddle/react-data-table.git"
  },
  "license": "MIT",
  "author": "Anthony Liddle",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:storybook": "vitest run --project storybook",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./styles.layer.css",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm run lint:ci && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run lint:package && pnpm run smoke"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
